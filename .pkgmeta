# Metadaten fuer den CurseForge/WoWInterface-Packager.
# package-as bestimmt den Ordnernamen im Zip -- er MUSS dem .toc-Namen
# entsprechen, sonst laedt WoW das Addon nicht.
package-as: CCAlarm

enable-nolib-creation: no

ignore:
  - tests
  - tools
  - .github
  - CHANGELOG.md
  # Nur fuer die CurseForge-Projektseite, nicht fuer das Spiel. Waere die Datei
  # im Zip, laedt WoW sie mit, ohne sie je zu benutzen.
  - docs
  - Media/logo.png
